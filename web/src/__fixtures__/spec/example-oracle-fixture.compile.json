          "name": "held",
          "condition": {
            "kind": "otherwise"
          },
          "subject": {
            "entity": "oracle.order.Order",
            "effect": "moves",
            "transition": {
              "name": "hold",
              "from": ["Placed"],
              "to": "Held"
            },
            "instance": {
              "from": "supplied",
              "field": {
                "name": "order_id",
                "type_ref": {
                  "kind": "declared",
                  "name": "oracle.order.OrderId"
                },
                "naming": {}
              }
            }
          },
          "test_strategy": "default_branch",
          "emits": ["oracle.order.OrderHeld"],
          "summary": "The order is held for review."
        },
        {
          "name": "wrong-state",
          "condition": {
            "kind": "wrong_state"
          },
          "test_strategy": "arrange_state",
          "emits": [],
          "error": "oracle.order.OrderStateConflict",
          "summary": "The order is not Placed, so it was not held."
        }
      ],
      "naming": {
        "wire": "hold-order",
        "display": "Hold order"
      }
    },
    "oracle.order.PlaceOrder": {
      "name": "oracle.order.PlaceOrder",
      "domain": "oracle.order",
      "input": [
        {
