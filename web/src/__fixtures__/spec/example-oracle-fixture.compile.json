            "name": "oracle.dispatch.Recipient"
          },
          "naming": {}
        },
        {
          "name": "label",
          "type_ref": {
            "kind": "declared",
            "name": "oracle.dispatch.Label"
          },
          "naming": {}
        }
      ],
      "outcomes": [
        {
          "name": "accepted",
          "condition": {
            "kind": "otherwise"
          },
          "test_strategy": "default_branch",
          "emits": ["oracle.dispatch.HandedOff"],
          "summary": "The carrier took it."
        },
        {
          "name": "refused",
          "condition": {
            "kind": "external",
            "cause": "the carrier has no capacity for this handoff"
          },
          "test_strategy": "inject_fault",
          "emits": [],
          "error": "oracle.dispatch.NoCapacity",
          "summary": "The carrier refused; no input decides this, so a scenario injects it."
        }
      ],
      "naming": {
        "wire": "handoff",
        "display": "Hand off"
      }
    },
    "oracle.order.AmendOrder": {
      "name": "oracle.order.AmendOrder",
      "domain": "oracle.order",
      "input": [
        {
          "name": "order_id",
          "type_ref": {
            "kind": "declared",
            "name": "oracle.order.OrderId"
          },
          "naming": {}
        },
        {
          "name": "weight_grams",
          "type_ref": {
            "kind": "primitive",
            "name": "integer"
          },
          "naming": {}
        }
      ],
      "outcomes": [
        {
          "name": "amended",
          "condition": {
            "kind": "when",
            "predicate": "weight_grams >= 0"
          },
          "subject": {
            "entity": "oracle.order.Order",
            "effect": "updates",
            "instance": {
              "from": "supplied",
              "field": {
                "name": "order_id",
                "type_ref": {
                  "kind": "declared",
                  "name": "oracle.order.OrderId"
                },
                "naming": {}
              }
            }
          },
          "test_strategy": "construct_input",
          "emits": ["oracle.order.OrderAmended"],
          "summary": "The recorded weight changes; the order stays where it is."
        },
        {
          "name": "rejected",
          "condition": {
            "kind": "otherwise"
          },
          "test_strategy": "default_branch",
          "emits": [],
          "error": "oracle.order.WeightOutOfRange",
          "summary": "The weight was negative, so the order was left alone."
        }
      ],
      "naming": {
        "wire": "amend-order",
        "display": "Amend order"
      }
    },
    "oracle.order.CancelOrder": {
      "name": "oracle.order.CancelOrder",
      "domain": "oracle.order",
      "input": [
        {
          "name": "order_id",
          "type_ref": {
            "kind": "declared",
            "name": "oracle.order.OrderId"
          },
          "naming": {}
        }
      ],
      "outcomes": [
        {
          "name": "cancelled",
          "condition": {
            "kind": "otherwise"
          },
          "subject": {
            "entity": "oracle.order.Order",
            "effect": "moves",
            "transition": {
              "name": "cancel",
              "from": ["Held", "Placed"],
              "to": "Cancelled"
            },
            "instance": {
              "from": "supplied",
              "field": {
                "name": "order_id",
                "type_ref": {
                  "kind": "declared",
                  "name": "oracle.order.OrderId"
                },
                "naming": {}
              }
            }
          },
          "test_strategy": "default_branch",
          "emits": ["oracle.order.OrderCancelled"],
          "summary": "The order is cancelled, from Placed or from Held — never from Shipped."
        },
        {
          "name": "wrong-state",
          "condition": {
            "kind": "wrong_state"
          },
          "test_strategy": "arrange_state",
          "emits": [],
          "error": "oracle.order.OrderStateConflict",
          "summary": "The order has shipped or is already cancelled, so nothing was cancelled."
        }
      ],
      "naming": {
        "wire": "cancel-order",
        "display": "Cancel order"
      }
    },
    "oracle.order.HoldOrder": {
      "name": "oracle.order.HoldOrder",
