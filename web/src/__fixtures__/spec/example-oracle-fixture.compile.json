  },
  "conversions": [
    {
      "from": {
        "kind": "declared",
        "name": "oracle.order.Email"
      },
      "to": {
        "kind": "declared",
        "name": "oracle.dispatch.Recipient"
      },
      "because": "An order's contact address is where the carrier's notice goes; the dispatch context validates it again on the way out, so the order context does not have to know how."
    }
  ],
  "entities": {
    "oracle.order.Order": {
      "name": "oracle.order.Order",
      "domain": "oracle.order",
      "identity": {
        "name": "order_id",
