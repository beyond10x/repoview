{
  "system": "oracle",
  "version": 1,
  "naming": {},
  "summary": "Orders handed off to a carrier: the smallest specification that holds the constructs the normative example deliberately does not — all three `on_failure` policies, three bindings so dropping one leaves another to stay green, an outcome that updates an entity without moving it, a filtered view at each consistency level, and an event carrying two fields of one type so a mapping can be swapped rather than invented.",
  "domains": {
    "oracle.dispatch": {
      "name": "oracle.dispatch",
      "naming": {
        "summary": "Handing an order to a carrier, which may refuse for reasons no input predicts."
      },
      "types": ["oracle.dispatch.HandoffId", "oracle.dispatch.Label", "oracle.dispatch.Recipient"],
      "entities": [],
      "commands": ["oracle.dispatch.Handoff"],
      "events": ["oracle.dispatch.HandedOff", "oracle.dispatch.HandoffEscalated"],
      "errors": ["oracle.dispatch.NoCapacity"],
      "views": [],
      "actors": []
    },
    "oracle.order": {
      "name": "oracle.order",
      "naming": {
        "wire": "orders",
        "display": "Ordering",
        "summary": "Orders, and the states one passes through on its way out of the building."
      },
      "types": ["oracle.order.Email", "oracle.order.Order.State", "oracle.order.OrderId"],
      "entities": ["oracle.order.Order"],
      "commands": [
        "oracle.order.AmendOrder",
        "oracle.order.CancelOrder",
        "oracle.order.HoldOrder",
        "oracle.order.PlaceOrder",
        "oracle.order.ShipOrder"
      ],
      "events": [
        "oracle.order.OrderAmended",
        "oracle.order.OrderCancelled",
        "oracle.order.OrderHeld",
        "oracle.order.OrderPlaced",
        "oracle.order.OrderShipped"
      ],
      "errors": ["oracle.order.OrderStateConflict", "oracle.order.WeightOutOfRange"],
      "views": ["oracle.order.HeldOrders", "oracle.order.OpenOrders"],
      "actors": []
    }
  },
  "types": {
