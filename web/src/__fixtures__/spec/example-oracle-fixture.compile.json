      "outcomes": [
        {
          "name": "accepted",
          "condition": {
            "kind": "when",
            "predicate": "weight_grams >= 0"
          },
          "subject": {
            "entity": "oracle.order.Order",
            "effect": "creates",
            "instance": {
              "from": "observed",
              "event": "oracle.order.OrderPlaced",
              "field": {
                "name": "order_id",
                "type_ref": {
                  "kind": "declared",
                  "name": "oracle.order.OrderId"
                },
                "naming": {}
              }
            }
          },
          "test_strategy": "construct_input",
          "emits": ["oracle.order.OrderPlaced"],
          "summary": "The order is recorded, in Placed.",
          "sets": [
            {
              "target": "weight_grams",
              "target_type": {
                "kind": "primitive",
                "name": "integer"
              },
              "value": {
                "kind": "input_field",
                "field": "weight_grams",
                "type_ref": {
                  "kind": "primitive",
                  "name": "integer"
                }
              }
            }
          ]
        },
        {
          "name": "rejected",
          "condition": {
            "kind": "otherwise"
          },
          "test_strategy": "default_branch",
          "emits": [],
          "error": "oracle.order.WeightOutOfRange",
          "summary": "The weight was negative, and nothing was recorded."
        }
      ],
      "naming": {
        "wire": "place-order",
        "display": "Place order"
      }
    },
    "oracle.order.ShipOrder": {
      "name": "oracle.order.ShipOrder",
      "domain": "oracle.order",
      "input": [
