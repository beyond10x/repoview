        "states": ["Cancelled", "Held", "Placed", "Shipped"],
        "initial": "Placed",
        "terminal": ["Cancelled", "Shipped"],
        "transitions": [
          {
            "name": "hold",
            "from": ["Placed"],
            "to": "Held"
          },
          {
            "name": "ship",
            "from": ["Placed"],
            "to": "Shipped"
          },
          {
            "name": "cancel",
            "from": ["Held", "Placed"],
            "to": "Cancelled"
          }
        ]
      },
      "invariants": ["weight_grams >= 0"],
      "naming": {}
    }
  },
  "commands": {
    "oracle.dispatch.Handoff": {
      "name": "oracle.dispatch.Handoff",
      "domain": "oracle.dispatch",
      "input": [
        {
