      "naming": {}
    },
    "gatepass.visit.EmployeeId": {
      "name": "gatepass.visit.EmployeeId",
      "body": {
        "kind": "newtype",
        "of": {
          "kind": "primitive",
          "name": "string"
        },
        "invariants": []
      },
      "naming": {}
