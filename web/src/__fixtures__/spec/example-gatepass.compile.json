          "name": "admitted",
          "condition": {
            "kind": "otherwise"
          },
          "subject": {
            "entity": "gatepass.visit.Visit",
            "effect": "moves",
            "transition": {
              "name": "arrive",
              "from": ["Expected"],
              "to": "OnSite"
            },
            "instance": {
              "from": "supplied",
              "field": {
                "name": "visit_id",
                "type_ref": {
                  "kind": "declared",
                  "name": "gatepass.visit.VisitId"
                },
                "naming": {}
              }
            }
          },
          "test_strategy": "default_branch",
          "emits": ["gatepass.visit.VisitorAdmitted"],
          "payload": [
            {
              "event": "gatepass.visit.VisitorAdmitted",
              "fields": [
                {
                  "target": "visit_id",
                  "target_type": {
                    "kind": "declared",
                    "name": "gatepass.visit.VisitId"
                  },
                  "value": {
                    "kind": "input_field",
                    "field": "visit_id",
                    "type_ref": {
                      "kind": "declared",
                      "name": "gatepass.visit.VisitId"
                    }
