                  "value": {
                    "kind": "input_field",
                    "field": "badge",
                    "type_ref": {
                      "kind": "declared",
                      "name": "gatepass.visit.Badge"
                    }
                  }
                }
              ]
            }
          ],
          "summary": "The visitor is on site, holding the badge that was printed.",
          "sets": [
            {
              "target": "badge",
              "target_type": {
                "kind": "optional",
                "of": {
                  "kind": "declared",
                  "name": "gatepass.visit.Badge"
                }
              },
              "value": {
                "kind": "input_field",
                "field": "badge",
                "type_ref": {
                  "kind": "declared",
                  "name": "gatepass.visit.Badge"
                }
              }
            }
          ]
        },
        {
          "name": "wrong-state",
          "condition": {
            "kind": "wrong_state"
          },
          "test_strategy": "arrange_state",
          "emits": [],
          "error": "gatepass.visit.VisitStateConflict",
          "summary": "The visit is not Expected, so nobody was admitted."
        }
      ],
      "naming": {
        "wire": "admit-visitor",
        "display": "Admit the visitor"
      }
    },
