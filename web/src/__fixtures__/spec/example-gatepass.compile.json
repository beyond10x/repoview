{
  "system": "gatepass",
  "version": 1,
  "naming": {},
  "summary": "Visitor passes for a building: who is expected, who is inside, and who has left. Three commands, two of which can be refused for two different reasons, one lifecycle, two projections and no binding — because the one transport this system has is the one its component's own words require, and nothing here reacts to an event.",
  "domains": {
    "gatepass.visit": {
      "name": "gatepass.visit",
      "naming": {
        "wire": "visits",
        "display": "Visits",
        "summary": "Expecting a visitor, letting them in, and letting them out again."
      },
      "types": [
        "gatepass.visit.Badge",
        "gatepass.visit.Building",
        "gatepass.visit.Deposit",
        "gatepass.visit.EmployeeId",
        "gatepass.visit.Host",
        "gatepass.visit.VendorRef",
        "gatepass.visit.Visit.State",
        "gatepass.visit.VisitId",
        "gatepass.visit.VisitorName"
      ],
      "entities": ["gatepass.visit.Visit"],
      "commands": [
        "gatepass.visit.AdmitVisitor",
        "gatepass.visit.RegisterVisit",
        "gatepass.visit.SignOutVisitor"
      ],
      "events": [
        "gatepass.visit.VisitRegistered",
        "gatepass.visit.VisitorAdmitted",
        "gatepass.visit.VisitorDeparted"
      ],
      "errors": ["gatepass.visit.InvalidVisitLength", "gatepass.visit.VisitStateConflict"],
      "views": ["gatepass.visit.ExpectedVisits", "gatepass.visit.VisitById"],
      "actors": ["gatepass.visit.Receptionist", "gatepass.visit.SecurityAuditor"]
    }
  },
